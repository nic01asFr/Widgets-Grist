{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capacites-0.1",
  "title": "Fiche de capacites d'un widget (brouillon, non catalogue)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contrat", "widget", "version", "presentation", "verbes", "non_couverts", "contrats"],
  "properties": {
    "contrat": { "const": "capacites-0.1" },
    "widget": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titre", "resume"],
      "properties": { "titre": { "type": "string", "minLength": 1 }, "resume": { "type": "string", "minLength": 1 } }
    },
    "verbes": {
      "type": "object",
      "propertyNames": { "enum": ["presenter", "configurer", "creer", "editer", "structurer", "personnaliser", "publier", "exploiter", "recolter", "traiter"] },
      "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+_[a-z0-9_]+$" }, "uniqueItems": true }
    },
    "non_couverts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["presenter", "configurer", "creer", "editer", "structurer", "personnaliser", "publier", "exploiter", "recolter", "traiter"] }
    },
    "contrats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produit", "lit"],
      "properties": {
        "produit": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "lit": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "prerequis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acces_grist": { "enum": ["none", "read table", "full"] },
        "tables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limites": { "type": "array", "items": { "type": "string" } },
    "exemples": { "type": "array", "items": { "type": "string" } }
  }
}
