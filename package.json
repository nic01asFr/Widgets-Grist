{
  "name": "widgets-grist",
  "version": "1.0.0",
  "private": true,
  "description": "Collection de widgets Grist - TaskFlow & Artefactory",
  "scripts": {
    "build": "echo 'No build required for static widgets'",
    "dev": "echo 'Ouvrir les fichiers HTML directement dans le navigateur'",
    "manifest": "node scripts/generate-manifest.js",
    "models": "node scripts/generate-models.js",
    "promote": "node scripts/promote.js",
    "promote:atlas": "node scripts/promote-atlas.js",
    "promote:grist-forms": "node scripts/promote-grist-forms.js",
    "build:taskflow": "node scripts/build-taskflow.js",
    "check:taskflow": "node scripts/build-taskflow.js --check",
  "check:atlas": "node projects/Atlas/tools/verifier-imports.mjs && node projects/Atlas/tools/verifier-references.mjs",
    "serve:dev": "node scripts/serve-dev.js",
    "serve": "npx serve published -p 3000 --cors",
    "promote:qgis2grist": "node scripts/promote-qgis2grist.js",
    "vitrine": "node scripts/generate-vitrine.js",
    "post": "node scripts/generate-post.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicO1asFr/Widgets-Grist.git"
  },
  "keywords": [
    "grist",
    "widgets",
    "kanban",
    "gantt",
    "calendar",
    "no-code"
  ],
  "author": "nicO1asFr",
  "license": "MIT",
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.10"
  }
}
