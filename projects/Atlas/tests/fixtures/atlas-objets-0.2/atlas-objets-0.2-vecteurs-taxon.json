  "rules": {
    "1": "valeur absente ou non textuelle -> ''",
    "2": "NFKC",
    "3": "U+00D7 -> ' x '",
    "4": "segments entre ' ', U+2018 U+2019, \" \", U+201C U+201D retires (remplaces par une espace) ; guillemet ouvrant sans fermeture : tout ce qui suit est retire",
    "5": "blancs [\\t\\n\\v\\f\\r ]+ -> une espace, bords retires (jamais \\s)",
    "6": "mot 'x' ou 'X' -> 'x' ; premier autre mot : premier point de code en majuscule, reste en minuscules ; mots suivants en minuscules (casse Unicode par defaut, sans locale)",
    "genus": "premier mot ; 'x <Genre>' si le nom commence par 'x'",
    "match": "N == C ou N commence par C + ' ' (N objet, C taxon, tous deux normalises ; vide : faux)",
    "object_taxon": "premier champ non vide apres normalisation parmi taxon_from (defaut species, genus)"
  },
