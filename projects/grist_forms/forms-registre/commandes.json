      "sortie": {
        "type": "object",
        "required": [
          "conforme",
          "ecarts"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Un FormDef vide",
          "entree": {
            "formdef": {}
          },
          "sortie": {
            "conforme": false,
            "ecarts": [
              "(racine) : propriété requise absente : manifest_version",
              "(racine) : propriété requise absente : id",
              "(racine) : propriété requise absente : title",
              "(racine) : propriété requise absente : tableId",
              "(racine) : propriété requise absente : composeMode",
              "(racine) : propriété requise absente : sections",
              "(racine) : propriété requise absente : choices"
            ]
          }
        }
      ]
    },
    {
      "nom": "forms_valider_condition",
      "verbe": "structurer",
      "description": "Contrôle une condition d’affichage (grammaire conditions-1.0). Rend les erreurs avec leur chemin ; `bloquant` dit si la condition serait refusée. Un opérateur inconnu est une faute, jamais « vrai ».",
      "entree": {
        "type": "object",
        "required": [
          "condition"
        ],
        "properties": {
          "condition": {}
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "valide",
          "erreurs"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Une règle correcte",
          "entree": {
            "condition": {
              "field": "age",
              "operator": ">=",
              "value": 18
            }
          },
          "sortie": {
            "valide": true,
            "erreurs": []
          }
        },
        {
          "titre": "Un opérateur inconnu",
          "entree": {
            "condition": {
              "field": "age",
              "operator": "presque",
              "value": 18
            }
          },
          "sortie": {
            "valide": false,
            "erreurs": [
              {
                "chemin": "/operator",
                "code": "operateur_inconnu",
                "message": "Opérateur « presque » inconnu : écrivez l'un de ==, !=, >, >=, <, <=, contains, in, notIn, truthy, empty, notEmpty.",
                "bloquant": true
              }
            ]
          }
        }
      ]
    },
    {
      "nom": "forms_verifier_format",
      "verbe": "structurer",
      "description": "Éprouve une valeur contre un format nommé (iban, siren, siret, codePostal, insee, heure, courriel, nom, prenom, nomComplet, telephone) et rend la forme normalisée. Un format inconnu laisse tout passer et le dit (`connu: false`). `message_si_invalide` est le message à montrer si la valeur est invalide, pas un verdict : le verdict est `valide`.",
      "entree": {
        "type": "object",
        "required": [
          "format",
          "valeur"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "valeur": {}
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "connu",
          "valide",
          "normalise",
          "message_si_invalide"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Un code postal",
          "entree": {
            "format": "codePostal",
            "valeur": "13001"
          },
          "sortie": {
            "connu": true,
            "valide": true,
            "normalise": "13001",
            "message_si_invalide": "Ce n’est pas un code postal (5 chiffres)."
          }
        }
      ]
    },
