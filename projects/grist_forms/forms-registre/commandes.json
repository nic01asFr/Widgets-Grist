{
  "contrat": "commandes-0.1",
  "widget": "forms",
  "version": "1.6.0",
  "commandes": [
    {
      "nom": "forms_capacites",
      "verbe": "presenter",
      "description": "Présente Form Builder : ce qu’il sait faire (les commandes par verbe), ce qu’il ne couvre pas encore, les contrats qu’il produit et lit, ses limites. À appeler en premier.",
      "entree": {
        "type": "object",
        "properties": {}
      },
      "sortie": {
        "type": "object"
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "La fiche de capacités",
          "entree": {},
          "sortie": {
            "contrat": "fiche-capacites-0.1",
            "widget": "forms",
            "version": "1.6.0",
            "presentation": {
              "titre": "Form Builder",
              "resume": "Compose un formulaire Grist, le relie à sa table, le publie dans le document et relit les réponses. Ces commandes ne font que lire et calculer : elles rendent des plans, elles n’écrivent rien dans un document."
            },
            "verbes": {
              "presenter": [
                "forms_capacites"
              ],
              "creer": [
                "forms_formdef_depuis_colonnes",
                "forms_formdef_depuis_formulaire_grist"
              ],
              "structurer": [
                "forms_valider_formdef",
                "forms_valider_condition",
                "forms_verifier_format",
                "forms_formdef_vers_manifeste_enquete",
                "forms_manifeste_enquete_vers_formdef"
              ],
              "configurer": [
                "forms_plan_schema"
              ],
              "personnaliser": [
                "forms_resoudre_theme"
              ],
              "publier": [
                "forms_plan_publication"
              ],
              "traiter": [
                "forms_synthese"
              ]
            },
            "non_couverts": [
              "editer",
              "exploiter",
              "recolter"
            ],
            "contrats": {
              "produit": [
                {
                  "nom": "FormDef",
                  "version": "1.0",
                  "catalogue": true
                },
                {
                  "nom": "Conditions",
                  "version": "1.0",
                  "catalogue": true
                },
                {
                  "nom": "Survey Manifest",
                  "version": "1",
                  "catalogue": false,
                  "empreinte": "sha256:147c959fee0b3b6e"
                }
              ],
              "lit": [
                {
                  "nom": "FormDef",
                  "version": "1.0",
                  "catalogue": true
                },
                {
                  "nom": "Conditions",
                  "version": "1.0",
                  "catalogue": true
                },
                {
                  "nom": "Survey Manifest",
                  "version": "1",
                  "catalogue": false,
                  "empreinte": "sha256:147c959fee0b3b6e"
                },
                {
                  "nom": "ThemeDef",
                  "version": "1.0",
                  "catalogue": false,
                  "empreinte": "sha256:a1ab777475df5d76"
                }
              ]
            },
            "prerequis": {
              "acces_grist": "none"
            },
            "limites": [
              "Version 1 en lecture seule : aucune commande n’écrit dans un document Grist.",
              "Appliquer un plan de schéma ou de publication n’est pas encore une commande.",
              "Le formulaire vivant (rendu, saisie, envoi) ne se pilote pas par ces commandes : il vit dans une page.",
              "Les commandes ne se connectent à aucun document : les tables et les réponses sont données en entrée."
            ],
            "exemples": [
              "forms_capacites",
              "forms_formdef_depuis_colonnes",
              "forms_formdef_depuis_formulaire_grist",
              "forms_valider_formdef",
              "forms_valider_condition",
              "forms_verifier_format",
              "forms_formdef_vers_manifeste_enquete",
              "forms_manifeste_enquete_vers_formdef",
              "forms_plan_schema",
              "forms_resoudre_theme",
              "forms_plan_publication",
              "forms_synthese"
            ]
          }
        }
      ]
    },
    {
      "nom": "forms_formdef_depuis_colonnes",
      "verbe": "creer",
      "description": "Déduit un FormDef des colonnes d’une table Grist (une question par colonne, hors colonnes internes). Rend `formdef: null` quand aucune colonne ne donne de question.",
      "entree": {
        "type": "object",
        "required": [
          "tableId",
          "colonnes"
        ],
        "properties": {
          "tableId": {
            "type": "string"
          },
          "colonnes": {
            "type": "array"
          },
          "titre": {
            "type": "string"
          },
          "ignorer": {
            "type": "array"
          }
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "formdef"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Une table de deux colonnes",
          "entree": {
            "tableId": "Inscriptions",
            "colonnes": [
              {
                "colId": "nom",
                "type": "Text",
                "label": "Nom"
              },
              {
                "colId": "age",
                "type": "Int",
                "label": "Âge"
              }
            ]
          },
          "sortie": {
            "formdef": {
              "manifest_version": "1.0.0",
              "id": "derive:Inscriptions",
              "title": "Inscriptions",
              "description": "",
              "tableId": "Inscriptions",
              "composeMode": "bind",
              "sections": [
                {
                  "id": "main",
                  "label": "Inscriptions",
                  "fields": [
                    {
                      "colId": "nom",
                      "label": "Nom",
                      "type": "Text",
                      "widget": "text",
                      "required": false
                    },
                    {
                      "colId": "age",
                      "label": "Âge",
                      "type": "Int",
                      "widget": "number",
                      "required": false
                    }
                  ]
                }
              ],
              "choices": {}
            }
          }
        }
      ]
    },
