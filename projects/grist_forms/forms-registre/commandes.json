    {
      "nom": "forms_valider_formdef",
      "verbe": "structurer",
      "description": "Contrôle un FormDef contre son contrat (formdef-1.0) et rend les écarts. Un FormDef conforme rend une liste d’écarts vide.",
      "entree": {
        "type": "object",
