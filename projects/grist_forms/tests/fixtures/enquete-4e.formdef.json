{
  "manifest_version": "1.0.0",
  "id": "enquete-espaces-publics-4e",
  "title": "Espaces publics — quartiers Gare et Parc",
  "description": "Enquête de référence du projet : 61 questions, toutes les formes de saisie. Branchée sur des colonnes existantes — aucune création, aucun retypage.",
  "classification": "interne",
  "successMessage": "Merci pour votre contribution !",
  "tableId": "Reponses",
  "composeMode": "bind",
  "meta": {
    "timestampCol": "Horodatage",
    "durationCol": "DureeSecondes"
  },
  "matrices": {
    "c_perception": {
      "titre": "Que pensez-vous des espaces publics du quartier ?",
      "consigne": "Pour chaque affirmation, dites à quel point vous êtes d’accord."
    },
    "f_stationnement": {
      "titre": "Qu’attendez-vous du stationnement des voitures ?",
      "consigne": "Pour chaque proposition, dites à quel point vous êtes d’accord."
    },
    "f_moto": {
      "titre": "Et pour les deux-roues motorisés ?"
    },
    "g_vitesses": {
      "titre": "Comment jugez-vous la circulation dans le quartier ?"
    },
    "h_bus": {
      "titre": "Que pensez-vous du bus dans le quartier ?"
    },
    "i_arceaux": {
      "titre": "Y a-t-il assez d’arceaux pour attacher les vélos ?"
    },
    "i_cohabitation": {
      "titre": "Et la cohabitation sur les trottoirs ?"
    },
    "j_ecoles": {
      "titre": "Que pensez-vous des abords d’école ?"
    },
    "k_chaleur": {
      "titre": "Ressentez-vous la chaleur dans le quartier ?"
    },
    "l_vegetalisation": {
      "titre": "Que pensez-vous de la végétalisation ?"
    },
    "m_modes": {
      "titre": "Quels modes de déplacement faudrait-il privilégier ?",
      "consigne": "En aménageant la voirie du quartier."
    }
  },
  "echelles": {
    "accord": {
      "min": 1,
      "max": 5,
      "libelles": [
        "Pas du tout d’accord",
        "Tout à fait d’accord"
      ],
      "nonConcerne": true
    },
    "arceaux": {
      "min": 1,
      "max": 5,
      "libelles": [
        "Très insuffisant",
        "Très suffisant"
      ],
      "nonConcerne": true
    },
    "priorite": {
      "min": 1,
      "max": 5,
      "libelles": [
        "Surtout pas",
        "En priorité"
      ],
      "nonConcerne": false
    }
