  "sections": [
    {
      "id": "A",
      "label": "Vous et le quartier",
      "fields": [
        {
          "colId": "A1_Sexe",
          "label": "Genre",
          "type": "Choice",
          "widget": "radio",
          "required": true,
          "options": {
            "choices": [
              "Une femme",
              "Un homme",
              "Autre / non-binaire",
              "Je préfère ne pas répondre"
            ]
          }
        },
        {
          "colId": "A2_Age",
          "label": "Tranche d’âge",
          "type": "Choice",
          "widget": "radio",
          "required": true,
          "options": {
            "choices": [
              "Moins de 18 ans",
              "18–24 ans",
              "25–39 ans",
              "40–59 ans",
              "60–74 ans",
              "75 ans et plus"
            ]
          }
        },
        {
          "colId": "A3_Position",
          "label": "Lien avec le quartier",
          "type": "ChoiceList",
          "widget": "multiselect",
          "required": true,
          "options": {
            "choices": [
              "Habitant du quartier",
              "Commerçant du quartier",
              "Je travaille dans le quartier",
              "Visiteur occasionnel / touriste"
            ]
          },
          "description": "Plusieurs réponses possibles"
        },
        {
          "colId": "A4_Anciennete",
          "label": "Ancienneté dans le quartier",
          "type": "Choice",
          "widget": "radio",
          "required": true,
          "options": {
            "choices": [
              "Moins d'un an",
              "1 à 5 ans",
              "5 à 10 ans",
              "Plus de 10 ans"
            ]
          },
          "condition": {
            "field": "A3_Position",
            "operator": "contains",
            "value": "Habitant du quartier"
          }
        }
      ]
    },
    {
      "id": "B",
      "label": "Vos déplacements",
      "condition": {
        "field": "A3_Position",
        "operator": "contains",
        "value": "Habitant du quartier"
      },
      "fields": [
        {
          "colId": "B1_NbVoitures",
          "label": "Nombre de voitures du ménage",
          "type": "Choice",
          "widget": "radio",
          "required": true,
          "options": {
            "choices": [
              "Pas de voiture",
              "1 voiture",
              "2 voitures ou plus"
            ]
          }
        },
        {
          "colId": "B2_LieuStationnement",
          "label": "Lieu de stationnement habituel",
          "type": "Choice",
          "widget": "radio",
          "required": true,
          "options": {
            "choices": [
              "Sur voirie",
              "Parking public",
              "Parking privé / garage"
            ]
          },
          "condition": {
            "op": "and",
            "rules": [
              {
                "field": "B1_NbVoitures",
                "operator": "truthy"
              },
              {
                "field": "B1_NbVoitures",
                "operator": "!=",
                "value": "Pas de voiture"
              }
            ]
          }
        },
        {
          "colId": "B3_Velo",
          "label": "Possède un vélo",
          "type": "Bool",
          "widget": "ouinon",
          "required": true
        },
        {
          "colId": "B4_MotoScooter",
          "label": "Possède une moto ou un scooter",
          "type": "Bool",
          "widget": "ouinon",
          "required": true
        },
        {
          "colId": "B5_ModeTravail",
          "label": "Mode(s) de déplacement domicile-travail",
          "type": "ChoiceList",
          "widget": "multiselect",
          "required": false,
          "options": {
            "choices": [
              "Voiture (conducteur)",
              "Voiture (passager/covoituré)",
              "Deux-roues motorisé (moto/scooter)",
              "Transports en commun",
              "Vélo",
              "Trottinette",
              "Marche à pied",
              "Pas de déplacement (télétravail)"
            ]
          }
        },
        {
          "colId": "B6_ModeAutres",
          "label": "Mode(s) de déplacement autres trajets",
          "type": "ChoiceList",
          "widget": "multiselect",
          "required": false,
          "options": {
            "choices": [
              "Voiture (conducteur)",
              "Voiture (passager/covoituré)",
              "Deux-roues motorisé (moto/scooter)",
              "Transports en commun",
              "Vélo",
              "Trottinette",
              "Marche à pied",
              "Aucun déplacement"
            ]
          }
        }
      ]
