  "definitions": {
    "valeur": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.%]{1,8}(?:\\s*[ ,/]\\s*[0-9.%]{1,8}){2,3}\\s*\\)|var\\(--[A-Za-z_][A-Za-z0-9_-]{0,63}\\))$",
      "description": "Une couleur en syntaxe connue (#rgb, #rgba, #rrggbb, #rrggbbaa, rgb(), rgba(), hsl(), hsla() à arguments numériques) ou une référence var(--nom) SANS valeur de repli. 48 caractères au plus. url(), calc(), color-mix(), un nom de couleur, un point-virgule ou une accolade sont refusés."
    }
