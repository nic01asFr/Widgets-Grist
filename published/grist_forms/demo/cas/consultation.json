              "centre": [
                2.7336,
                47.9986
              ],
              "zoom": 15.5,
              "fond": "plan",
              "legende": "Les cinq aménagements proposés, situés sur la place.",
              "reperes": [
                {
                  "option": "Planter des arbres",
                  "etiquette": "A",
                  "lon": 2.7318,
                  "lat": 47.9996
                },
                {
                  "option": "Élargir les trottoirs",
                  "etiquette": "B",
                  "lon": 2.7355,
                  "lat": 47.9991
                },
                {
                  "option": "Créer une aire de jeux",
                  "etiquette": "C",
                  "lon": 2.7344,
                  "lat": 47.9972
                },
                {
                  "option": "Garder le stationnement",
                  "etiquette": "D",
                  "lon": 2.731,
                  "lat": 47.997
                },
                {
                  "option": "Installer des bancs",
                  "etiquette": "E",
                  "lon": 2.7331,
                  "lat": 47.9983
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "lieu",
      "label": "Un endroit qui vous gêne",
      "fields": [
        {
          "colId": "Point",
          "label": "Montrez-le sur la carte",
          "type": "Text",
          "widget": "geo",
          "kind": "geometrie",
          "help": "Touchez la carte à l’endroit concerné.",
          "options": {
            "geometrie": "Point",
            "carte": {
              "centre": [
                2.7336,
                47.9986
              ],
              "zoom": 16,
              "fond": "plan"
            }
          }
        },
        {
          "colId": "Pourquoi",
          "label": "Pourquoi cet endroit ?",
          "type": "Text",
          "widget": "textarea"
        }
      ]
    }
