    {
      "nom": "forms_valider_formdef",
      "verbe": "structurer",
      "description": "Contrôle un FormDef contre son contrat (formdef-1.0) et rend les écarts. `conforme` ne dit QUE le respect du contrat : il ne garantit pas que forms_plan_schema produira un plan. `plan_realisable` dit si le plan serait calculé sur une table à créer, et `avertissements` rend les motifs de refus du plan (par exemple « choices manquants » pour un Choice sans choix). Un FormDef conforme rend une liste d’écarts vide.",
      "entree": {
        "type": "object",
        "required": [
          "formdef"
        ],
        "properties": {
          "formdef": {
            "type": "object"
          }
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "conforme",
          "ecarts",
          "plan_realisable",
          "avertissements"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Un FormDef vide",
          "entree": {
            "formdef": {}
          },
          "sortie": {
            "conforme": false,
            "ecarts": [
              "(racine) : propriété requise absente : manifest_version",
              "(racine) : propriété requise absente : id",
              "(racine) : propriété requise absente : title",
              "(racine) : propriété requise absente : tableId",
              "(racine) : propriété requise absente : composeMode",
              "(racine) : propriété requise absente : sections",
              "(racine) : propriété requise absente : choices"
            ],
            "plan_realisable": false,
            "avertissements": []
          }
        },
        {
          "titre": "Conforme au contrat, mais un Choice sans choix : le plan sera refusé",
          "entree": {
            "formdef": {
              "manifest_version": "1.0.0",
              "id": "exemple",
              "title": "Exemple",
              "tableId": "Exemple",
              "composeMode": "bind",
              "sections": [
                {
                  "id": "main",
                  "label": "Exemple",
                  "fields": [
                    {
                      "colId": "atelier",
                      "type": "Choice",
                      "widget": "select",
                      "label": "Atelier",
                      "required": false
                    }
                  ]
                }
              ],
              "choices": {}
            }
          },
          "sortie": {
            "conforme": true,
            "ecarts": [],
            "plan_realisable": false,
            "avertissements": [
              "Champ « atelier » : choices manquants pour Choice"
            ]
          }
        }
      ]
    },
    {
      "nom": "forms_valider_condition",
      "verbe": "structurer",
      "description": "Contrôle une condition d’affichage (grammaire conditions-1.0). Rend les erreurs avec leur chemin ; `bloquant` dit si la condition serait refusée. Un opérateur inconnu est une faute, jamais « vrai ».",
      "entree": {
        "type": "object",
        "required": [
          "condition"
        ],
        "properties": {
          "condition": {}
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "valide",
          "erreurs"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Une règle correcte",
          "entree": {
            "condition": {
              "field": "age",
              "operator": ">=",
              "value": 18
            }
          },
          "sortie": {
            "valide": true,
            "erreurs": []
          }
        },
        {
          "titre": "Un opérateur inconnu",
          "entree": {
            "condition": {
              "field": "age",
              "operator": "presque",
              "value": 18
            }
          },
          "sortie": {
            "valide": false,
            "erreurs": [
              {
                "chemin": "/operator",
                "code": "operateur_inconnu",
                "message": "Opérateur « presque » inconnu : écrivez l'un de ==, !=, >, >=, <, <=, contains, in, notIn, truthy, empty, notEmpty.",
                "bloquant": true
              }
            ]
          }
        }
      ]
    },
    {
      "nom": "forms_verifier_format",
      "verbe": "structurer",
      "description": "Éprouve une valeur contre un format nommé (iban, siren, siret, codePostal, insee, heure, courriel, nom, prenom, nomComplet, telephone) et rend la forme normalisée. Un format inconnu laisse tout passer et le dit (`connu: false`). `message_si_invalide` est le message à montrer si la valeur est invalide, pas un verdict : le verdict est `valide`. Pour attacher un format à une question d’un FormDef, ajouter au champ `validation: { \"format\": \"courriel\" }` (mode `verifier` par défaut : une réponse non conforme est refusée ; `corriger` remet la forme en ordre sans refuser, réservé aux noms).",
      "entree": {
        "type": "object",
        "required": [
          "format",
          "valeur"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "valeur": {}
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "connu",
          "valide",
          "normalise",
          "message_si_invalide"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Un code postal",
          "entree": {
            "format": "codePostal",
            "valeur": "13001"
          },
          "sortie": {
            "connu": true,
            "valide": true,
            "normalise": "13001",
            "message_si_invalide": "Ce n’est pas un code postal (5 chiffres)."
          }
        }
      ]
    },
