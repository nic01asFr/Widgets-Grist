    {
      "nom": "forms_plan_schema",
      "verbe": "configurer",
      "description": "Calcule le plan d’actions Grist qui crée la table et les colonnes manquantes d’un FormDef. Il ne lit AUCUN document : il compare le FormDef à `colonnes_existantes` et `table_existe`, que l’appelant doit fournir. Sans eux, il suppose une table sans colonne et prévoit un AddColumn par champ, sans AddTable. Il rend le plan sans l’appliquer ; il ne change jamais le type d’une colonne existante. Il refuse (`ok: false`, `errors`) un Choice ou ChoiceList sans liste de choix (dans `choices[colId]` à la racine ou `options.choices` du champ).",
      "entree": {
        "type": "object",
        "required": [
          "formdef"
        ],
        "properties": {
          "formdef": {
            "type": "object",
            "description": "Un FormDef (formdef-1.0). Les choix d’une question à choix : `options.choices` du champ ou `choices[colId]` à la racine."
          },
          "colonnes_existantes": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Les colonnes déjà présentes dans la table, au format { colId, type, … } ; à fournir pour que le plan ne recrée pas ce qui existe."
          },
          "table_existe": {
            "type": "boolean",
            "description": "Vrai si la table existe déjà : le plan n’émet alors pas d’AddTable."
          }
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "ok",
          "actions"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Une table absente",
          "entree": {
            "formdef": {
              "manifest_version": "1.0.0",
              "id": "exemple",
              "title": "Exemple",
              "tableId": "Exemple",
              "composeMode": "bind",
              "sections": [
                {
                  "id": "main",
                  "label": "Exemple",
                  "fields": [
                    {
                      "id": "nom",
                      "colId": "nom",
                      "type": "Text",
                      "label": "Nom"
                    }
                  ]
                }
              ],
              "choices": {}
            },
            "colonnes_existantes": [],
            "table_existe": false
          },
          "sortie": {
            "ok": true,
            "errors": [],
            "actions": [
              [
                "AddTable",
                "Exemple",
                [
                  {
                    "id": "nom",
                    "type": "Text",
                    "label": "Nom",
                    "isFormula": false
                  }
                ]
              ]
            ]
          }
        }
      ]
    },
