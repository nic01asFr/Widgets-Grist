    {
      "nom": "forms_formdef_depuis_colonnes",
      "verbe": "creer",
      "description": "Déduit un FormDef des colonnes d’une table Grist (une question par colonne, hors colonnes internes et colonnes calculées). Rend `formdef: null` quand aucune colonne ne donne de question. Les choix d’une colonne Choice ou ChoiceList sont lus dans son `widgetOptions` (chaîne JSON `{\"choices\":[\"a\",\"b\"]}`) et rangés dans `options.choices` du champ ; sans `widgetOptions`, le champ n’a pas de choix et forms_plan_schema le refusera. La racine `choices` du FormDef rendu reste `{}` : les choix vivent dans le champ.",
      "entree": {
        "type": "object",
        "required": [
          "tableId",
          "colonnes"
        ],
        "properties": {
          "tableId": {
            "type": "string",
            "description": "Identifiant Grist de la table."
          },
          "colonnes": {
            "type": "array",
            "description": "Les colonnes telles que `_grist_Tables_column` les donne.",
            "items": {
              "type": "object",
              "required": [
                "colId",
                "type"
              ],
              "properties": {
                "colId": {
                  "type": "string",
                  "description": "Identifiant de la colonne."
                },
                "type": {
                  "type": "string",
                  "description": "Type Grist : Text, Int, Numeric, Bool, Date, DateTime, Choice, ChoiceList, Ref:Table, RefList:Table, Attachments."
                },
                "label": {
                  "type": "string",
                  "description": "Libellé affiché ; à défaut, le colId."
                },
                "isFormula": {
                  "type": "boolean",
                  "description": "Vrai pour une colonne calculée : elle est écartée."
                },
                "widgetOptions": {
                  "type": "string",
                  "description": "Chaîne JSON des options Grist ; porte la liste des choix : {\"choices\":[\"a\",\"b\"]}."
                },
                "visibleCol": {
                  "description": "Colonne affichée pour une référence."
                }
              }
            }
          },
          "titre": {
            "type": "string",
            "description": "Titre du formulaire ; à défaut, le tableId."
          },
          "ignorer": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "colId à écarter en plus des colonnes internes (par exemple la géométrie d’une couche)."
          }
        }
      },
      "sortie": {
        "type": "object",
        "required": [
          "formdef"
        ]
      },
      "nature": "pure",
      "ecrit": "rien",
      "exemples": [
        {
          "titre": "Une table de deux colonnes",
          "entree": {
            "tableId": "Inscriptions",
            "colonnes": [
              {
                "colId": "nom",
                "type": "Text",
                "label": "Nom"
              },
              {
                "colId": "age",
                "type": "Int",
                "label": "Âge"
              }
            ]
          },
          "sortie": {
            "formdef": {
              "manifest_version": "1.0.0",
              "id": "derive:Inscriptions",
              "title": "Inscriptions",
              "description": "",
              "tableId": "Inscriptions",
              "composeMode": "bind",
              "sections": [
                {
                  "id": "main",
                  "label": "Inscriptions",
                  "fields": [
                    {
                      "colId": "nom",
                      "label": "Nom",
                      "type": "Text",
                      "widget": "text",
                      "required": false
                    },
                    {
                      "colId": "age",
                      "label": "Âge",
                      "type": "Int",
                      "widget": "number",
                      "required": false
                    }
                  ]
                }
              ],
              "choices": {}
            }
          }
        },
        {
          "titre": "Une colonne à choix, lus dans widgetOptions",
          "entree": {
            "tableId": "Inscriptions",
            "colonnes": [
              {
                "colId": "atelier",
                "type": "Choice",
                "label": "Atelier",
